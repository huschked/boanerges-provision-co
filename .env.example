# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_TAX_CODE=txcd_99999999
# A processing webhook can be reclaimed after this lease expires (30-3600 seconds).
STRIPE_EVENT_PROCESSING_TIMEOUT_SECONDS=300
FREE_SHIPPING_THRESHOLD=50
STANDARD_SHIPPING_AMOUNT=5.99
# Reusable recurring Stripe Prices for the standard shipping charge. Configure the
# Stripe Product with the Shipping tax code (txcd_92010001). Each Price must match
# STANDARD_SHIPPING_AMOUNT and recur every 1, 2, or 3 months respectively.
STRIPE_SUBSCRIPTION_SHIPPING_PRICE_MONTHLY=
STRIPE_SUBSCRIPTION_SHIPPING_PRICE_EVERY_TWO_MONTHS=
STRIPE_SUBSCRIPTION_SHIPPING_PRICE_EVERY_THREE_MONTHS=
MAX_CART_ITEMS=30
MAX_ITEM_QUANTITY=20
INVENTORY_RESERVATION_MINUTES=31

# Resend
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_WEBHOOK_SECRET=
# Owner-approved public mailing address. Blank disables marketing welcome emails.
MARKETING_POSTAL_ADDRESS=
RESEND_TEST_RECIPIENT=
EMAIL_FROM_ORDERS="Boanerges Provisions Co <orders@boanergesprovisions.com>"
EMAIL_FROM_SUPPORT="Boanerges Provisions Co Support <support@boanergesprovisions.com>"
EMAIL_FROM_GENERAL="Boanerges Provisions Co <hello@boanergesprovisions.com>"
ORDERS_NOTIFICATION_EMAIL=orders@boanergesprovisions.com
INQUIRIES_NOTIFICATION_EMAIL=hello@boanergesprovisions.com

# App
# Legacy fallback for both notification inboxes; prefer the two scoped settings above.
ADMIN_EMAIL=
APP_URL=http://localhost:8080
SHARED_APP_URL=
# At least 32 unpredictable characters. Keep stable so emailed status links remain valid.
ORDER_STATUS_SECRET=
# Signed customer status links expire after this many days (1-365).
ORDER_STATUS_TOKEN_DAYS=90

# Firebase Admin (optional if using Application Default Credentials or hosted runtime identity)
# FIREBASE_SERVICE_ACCOUNT_KEY accepts raw JSON or base64-encoded service-account JSON.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Runtime
NODE_ENV=development
# Shippo label purchasing (use shippo_test_... outside production)
SHIPPO_API_TOKEN=
# Random secret embedded in the Shippo webhook URL; use at least 32 unpredictable characters.
SHIPPO_WEBHOOK_SECRET=
# Temporarily exposes sanitized Shippo request/response bodies to authenticated admins. Keep false in production.
SHIPPO_DEBUG=false
SHIPPO_FROM_NAME="Boanerges Provisions Co"
SHIPPO_FROM_STREET1=
SHIPPO_FROM_STREET2=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=
SHIPPO_FROM_EMAIL=orders@boanergesprovisions.com
