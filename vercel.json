{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{ "path": "/api/cron/review-requests", "schedule": "0 15 * * *" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": ".seo-build/storefront-shell.html"
    }
  },
  "headers": [
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/checkout/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/checkout-success/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/success/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/order-status/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/review/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/email-preferences/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api?path=seo/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api?path=seo/sitemap.xml" },
    { "source": "/review", "destination": "/api?path=seo&route=/review" },
    { "source": "/email-preferences", "destination": "/api?path=seo&route=/email-preferences" },
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api?path=seo&route=/admin/:path*"
    },
    { "source": "/product/:slug", "destination": "/api?path=seo&route=/product/:slug" },
    {
      "source": "/checkout/:path*",
      "destination": "/api?path=seo&route=/checkout/:path*"
    },
    {
      "source": "/checkout-success",
      "destination": "/api?path=seo&route=/checkout-success"
    },
    {
      "source": "/success",
      "destination": "/api?path=seo&route=/success"
    },
    { "source": "/", "destination": "/api?path=seo&route=/" },
    { "source": "/shop", "destination": "/api?path=seo&route=/shop" },
    { "source": "/about", "destination": "/api?path=seo&route=/about" },
    { "source": "/recipes", "destination": "/api?path=seo&route=/recipes" },
    { "source": "/faq", "destination": "/api?path=seo&route=/faq" },
    { "source": "/contact", "destination": "/api?path=seo&route=/contact" },
    { "source": "/bundles", "destination": "/api?path=seo&route=/bundles" },
    { "source": "/returns", "destination": "/api?path=seo&route=/returns" },
    { "source": "/privacy", "destination": "/api?path=seo&route=/privacy" },
    { "source": "/terms", "destination": "/api?path=seo&route=/terms" },
    {
      "source": "/order-status",
      "destination": "/api?path=seo&route=/order-status"
    }
  ]
}
